# Copy to .env and fill in real values. Never commit .env.

# --- OpenAI ---
OPENAI_API_KEY=sk-replace-me
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Postgres ---
POSTGRES_DB=triagent
POSTGRES_USER=triagent
POSTGRES_PASSWORD=triagent
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Qdrant ---
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=docs_corpus

# --- Backend (Spring Boot) ---
BACKEND_PORT=8080
TRIAGE_CONFIDENCE_THRESHOLD=0.9
AGENT_SERVICE_URL=http://agent-service:8000

# --- Agent service (FastAPI + LangGraph) ---
AGENT_SERVICE_PORT=8000
BACKEND_CALLBACK_URL=http://backend:8080

# --- Frontend ---
FRONTEND_PORT=5173

# --- Observability ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin
